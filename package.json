{
  "name": "pulseshift",
  "description": "Supabase-backed healthcare scheduling SaaS for workforce requests, approvals, and AI-assisted staffing decisions.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:client": "npm run dev",
    "dev:server": "npm --prefix ../pulseshift-server run dev",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "server": "npm --prefix ../pulseshift-server run start",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  }
}
